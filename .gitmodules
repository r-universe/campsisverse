[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "campsis"]
	path = campsis
	url = https://github.com/campsisverse/campsis
[submodule "campsismod"]
	path = campsismod
	url = https://github.com/campsisverse/campsismod
[submodule "campsisnca"]
	path = campsisnca
	url = https://github.com/campsisverse/campsisnca
